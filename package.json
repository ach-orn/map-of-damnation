{
  "name": "map-of-damnation",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace ui",
    "build": "npm run build --workspace @map-of-damnation/model && npm run build --workspace ui",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:e2e": "npm run test:e2e --workspace ui",
    "test:ui": "npm run test:ui --workspace ui"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  }
}
