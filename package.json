{
  "name": "map-of-damnation",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint .",
    "test": "turbo run test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:e2e": "turbo run test:e2e",
    "test:ui": "turbo run test:ui"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.9"
  }
}
